---
const today = new Date();
---

<footer>
	<div class="footer-content">
		&copy; {today.getFullYear()} Astronaut. All rights reserved.
		<div class="links">
			<a href="https://github.com/mdtalhachy">Github</a>
			<a href="https://www.linkedin.com/in/mdtalhachy/">Linkedin</a>
		</div>
	</div>
</footer>
<style>
	footer {
		margin-top: 4rem;
		padding-top: 1rem;
		border-top: 1px dashed var(--border-color);
		font-size: 0.9em;
		color: #555;
	}
	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.links {
		display: flex;
		gap: 1rem;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
		color: var(--text-color);
	}
</style>
