---
const today = new Date();
---

<footer>
	<div class="footer-content">
		&copy; {today.getFullYear()} Bukhari Bin Mahmud.
		<div class="links">
			<a href="https://github.com/Bukhari-Bin-Mahmud" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href="https://www.facebook.com/bukharibinmahmud" target="_blank" rel="noopener noreferrer">Facebook</a>
			<a href="https://wa.me/8801521762225" target="_blank" rel="noopener noreferrer">WhatsApp</a>
		</div>
	</div>
</footer>
<style>
	footer {
		margin-top: 4rem;
		padding-top: 1rem;
		border-top: 1px dashed var(--border-color);
		font-size: 0.8em;
		color: #555;
	}
	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.links {
		display: flex;
		gap: 1rem;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
</style>
