---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ListItem from '../components/ListItem.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Bukhari Bin Mahmud</h1>
			<p>
				"I can make it happen. I am confident in my ability to get the job done."
			</p>
			<p>
				I'm a Computer Science student who loves building practical tools and intelligent systems. From automated scrapers to real-time computer vision applications, I focus on shipping software that solves actual problems.
			</p>
			<p>
				I got admitted to my uni 2 months after that semester had already started. This was my first time staying someplace other than home.
			</p>
			<p>
				I knew basically nothing about CS before. My classmates already knew coding, development. So I thought only in academics do I have a level playing field. So I worked hard to see if I could get a 4.00 out of 4.00 and I did.
			</p>

			<h2>Currently Reading</h2>
			<ul>
				<ListItem title="The Almanack of Naval Ravikant" description="A guide to wealth and happiness." />
				<ListItem title="The Value of Others" description="Understanding social dynamics." />
			</ul>
			<div>
				<a href="/library" class="see-more-link">See more...</a>
			</div>

			<h2>Engineering Projects</h2>
			<ul>
				<ListItem title="AI Workout Spotter" description="Real-time CV that corrects your form with voice feedback." />
				<ListItem title="Routine Scraper" description="Automated schedule parsing and data extraction." />
			</ul>
			<div>
				<a href="/projects" class="see-more-link">See more...</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
