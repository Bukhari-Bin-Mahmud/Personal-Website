---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ListItem from '../components/ListItem.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Bukhari Bin Mahmud</h1>
			<p>
				"I can make it happen. I am confident in my ability to get the job done."
			</p>
			<p>
				I'm a Computer Science student who loves building practical tools and intelligent systems. From automated scrapers to real-time computer vision applications, I focus on shipping software that solves actual problems.
			</p>

			<h2>Currently Reading</h2>
			<ul>
				<ListItem href="/library" title="The Almanack of Naval Ravikant — Eric Jorgenson" symbol="◇" />
				<ListItem href="/library" title="The Value of Others — Orion Taraban" symbol="◇" />
			</ul>
			<a href="/library" style="font-size: 0.9em;">See more →</a>

			<h2>Engineering Projects</h2>
			<ul>
				<ListItem href="/projects" title="AI Workout Spotter — Real-time CV that corrects your form with voice feedback" symbol="✦" />
				<ListItem href="/projects" title="Routine Scraper — Automated schedule parsing and data extraction" symbol="✦" />
			</ul>
		</main>
		<Footer />
	</body>
</html>
