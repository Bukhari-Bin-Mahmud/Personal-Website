---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ListItem from '../components/ListItem.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Generalist</h1>
			<p>
				Most interesting problems sit between fields.
			</p>
			<p>
				I keep circling the same question: how does knowledge become skill? I write and build across cognitive science, AI systems, and embodied skill, investigating how intelligence works whether it’s running on neurons, language models, or a pool player’s hands. This is where I think out loud.
			</p>

			<h2>Currently Reading</h2>
			<ul>
				<ListItem href="/library" title="The Art of Doing Science and Engineering — Hamming on research taste" symbol="◇" />
				<ListItem href="/library" title="Designing Data-Intensive Applications — Systems architecture patterns" symbol="◇" />
				<ListItem href="/library" title="Shape Up — Basecamp's product methodology" symbol="◇" />
			</ul>
			<a href="/library" style="font-size: 0.9em;">See more →</a>

			<h2>AI & Engineering</h2>
			<ul>
				<ListItem href="/blog/ai-agent-team" title="The Spec Is Everything: How I Built a 14-Agent Team That Actually Works" symbol="✦" />
				<ListItem href="/blog/your-ai-vs-my-ai" title="Your AI vs My AI" symbol="✦" />
				<ListItem href="/blog/ai-native-products" title="Building AI-Native Products" symbol="✦" />
			</ul>

			<h2>Product & Strategy</h2>
			<ul>
				<ListItem href="/blog/questionbench" title="QuestionBench: AI Evaluation" symbol="✧" />
				<ListItem href="/blog/spec-to-ship" title="The Spec-to-Ship Pipeline" symbol="✧" />
			</ul>
		</main>
		<Footer />
	</body>
</html>
