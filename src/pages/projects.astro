---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ListItem from '../components/ListItem.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Projects</h1>
			<p>
				A selection of things I've built.
			</p>

			<h2>Active Projects</h2>
			<ul>
				<ListItem href="#" title="AI Workout Spotter — Real-time computer vision tracker that analyzes exercise form and gives vocal corrections." symbol="◆" />
				<ListItem href="#" title="Routine Scraper — Data extraction tool to automatically parse schedules." symbol="◆" />
			</ul>

			<h2>Archived</h2>
			<ul>
				<ListItem href="#" title="Early CS Scripts — Various university assignments and scripts." symbol="◇" />
			</ul>
		</main>
		<Footer />
	</body>
</html>
