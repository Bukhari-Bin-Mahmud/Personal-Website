---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ListItem from '../components/ListItem.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Library | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Library</h1>
			<p>
				Books, articles, and papers that have shaped my thinking.
			</p>

			<h2>Currently Reading</h2>
			<ul>
				<ListItem title="The Almanack of Naval Ravikant" description="A guide to wealth and happiness." accent={true} />
				<ListItem title="The Value of Others" description="Understanding social dynamics." accent={true} />
			</ul>

			<h2>Hall of Fame</h2>
			<ul>
				<ListItem title="The Inner Game of Tennis" description="Mental game for skill acquisition." />
				<ListItem title="Working in Public" description="Open source maintainer dynamics." />
				<ListItem title="Thinking in Systems" description="A primer on leverage points." />
			</ul>
		</main>
		<Footer />
	</body>
</html>
